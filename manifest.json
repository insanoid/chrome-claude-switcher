{
  "manifest_version": 3,
  "name": "Claude Session Switcher",
  "version": "1.1.0",
  "description": "Save Claude.ai logins and switch between them.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["cookies", "storage", "browsingData", "scripting", "activeTab"],
  "host_permissions": ["https://claude.ai/*", "https://*.claude.ai/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Claude sessions",
    "default_popup": "switcher.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "open-switcher": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Open the centred switcher"
    },
    "_execute_action": {
      "description": "Open the toolbar popup"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["switcher.html", "switcher.css", "switcher.js", "icons/mark.svg"],
      "matches": ["<all_urls>"]
    }
  ]
}
